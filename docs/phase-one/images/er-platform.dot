"platform_notification" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#fff1da"><B>platform_notification</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR></TABLE>>];
"data_dictionary" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#fff1da"><B>data_dictionary</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR></TABLE>>];
}
"sys_department" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#f1f5f9"><B>sys_department</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR><TR><TD ALIGN="LEFT">name [UK]</TD></TR><TR><TD ALIGN="LEFT">manager_id [FK] nullable</TD></TR><TR><TD ALIGN="LEFT">parent_id [FK] nullable</TD></TR></TABLE>>];
