"sys_role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#f1f5f9"><B>sys_role</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR><TR><TD ALIGN="LEFT">code [UK]</TD></TR></TABLE>>];
"sys_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#f1f5f9"><B>sys_user</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR></TABLE>>];
"admin_department" -> "sys_department" [label="department_id -> id", taillabel="0..N", headlabel="1", labeldistance=1.8];
"admin_department" -> "sys_user" [label="user_id -> id", taillabel="0..N", headlabel="1", labeldistance=1.8];
"approval_record" -> "sys_role" [label="role_id -> id", taillabel="0..N", headlabel="1", labeldistance=1.8];
"approval_record" -> "sys_user" [label="user_id -> id", taillabel="0..N", headlabel="1", labeldistance=1.8];
"department_permission" -> "sys_department" [label="department_id -> id", taillabel="0..N", headlabel="1", labeldistance=1.8];
"department_permission" -> "sys_permission" [label="permission_id -> id", taillabel="0..N", headlabel="1", labeldistance=1.8];
"managed_role" -> "sys_department" [label="department_id -> id", taillabel="0..N", headlabel="1", labeldistance=1.8];
}
