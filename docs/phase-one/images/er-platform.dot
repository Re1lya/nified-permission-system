digraph ER {
graph [rankdir=LR, pack=true, packmode="array3", bgcolor="white", pad=0.4, nodesep=0.35, ranksep=0.8, fontname="Arial", fontsize=24, labelloc=t, label="Administration and lifecycle (15 tables; external parent tables repeated)\nPhysical FK constraints only; no line does not mean no business reference"];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#60788a", arrowsize=0.65];
subgraph cluster_platform { label="Administration and lifecycle"; color="#cbd5df"; style=rounded;
"admin_department" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#fff1da"><B>admin_department</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR><TR><TD ALIGN="LEFT">department_id [FK]</TD></TR><TR><TD ALIGN="LEFT">user_id [FK]</TD></TR></TABLE>>];
"managed_role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#fff1da"><B>managed_role</B></TD></TR><TR><TD ALIGN="LEFT">role_id [PK]</TD></TR><TR><TD ALIGN="LEFT">department_id [FK]</TD></TR></TABLE>>];
"department_permission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#fff1da"><B>department_permission</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR><TR><TD ALIGN="LEFT">department_id [FK]</TD></TR><TR><TD ALIGN="LEFT">permission_id [FK]</TD></TR></TABLE>>];
"account_policy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#fff1da"><B>account_policy</B></TD></TR><TR><TD ALIGN="LEFT">user_id [PK]</TD></TR></TABLE>>];
"session_activity" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#fff1da"><B>session_activity</B></TD></TR><TR><TD ALIGN="LEFT">session_id [PK]</TD></TR></TABLE>>];
"login_attempt" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#fff1da"><B>login_attempt</B></TD></TR><TR><TD ALIGN="LEFT">username [PK]</TD></TR></TABLE>>];
"approval_record" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#fff1da"><B>approval_record</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD></TR><TR><TD ALIGN="LEFT">request_id [UK]</TD></TR><TR><TD ALIGN="LEFT">role_id [FK]</TD></TR><TR><TD ALIGN="LEFT">user_id [FK]</TD></TR></TABLE>>];
